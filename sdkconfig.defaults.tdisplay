CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Two cores: core 0 measures (Wi-Fi/PHY, captures), core 1 draws.
# CONFIG_FREERTOS_UNICORE is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_PHY_IRAM_OPT is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set

CONFIG_ESP_SDR_UART_ENABLED=y
CONFIG_ESP_SDR_UART_BAUD=2000000

# LILYGO TTGO T-Display (ESP32-D0WDQ6, 4 MB flash, 1.14" ST7789 240x135).
CONFIG_ESP_SDR_TDISPLAY=y
CONFIG_ESP_SDR_SCAN_INTERVAL_S=9
CONFIG_ESP_SDR_PAGE_SECONDS=0
# The display driver must not push IRAM/DRAM into the RF dump aperture
# (sram_guard.ld); its SPI interrupt handler runs from flash instead.
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# Scans need a few RX buffers; the receiver itself never takes Wi-Fi frames.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
# Legacy touch driver (driver/touch_pad.h): simple and enough for two pads.
CONFIG_TOUCH_SUPPRESS_DEPRECATE_WARN=y
# Display SPI at 80 MHz (VSPI IO_MUX pins); 40 is the safe fallback.
CONFIG_ESP_SDR_TDISPLAY_SPI_MHZ=80
