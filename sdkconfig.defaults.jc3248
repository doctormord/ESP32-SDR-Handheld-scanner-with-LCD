CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_PM_ENABLE is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
# CONFIG_ESP_PHY_IRAM_OPT is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# Two cores: core 0 measures, core 1 draws (the ring capture's SPEC helper
# on a bare-metal core 1 is then off; SPEC streaming runs single-core).
# CONFIG_FREERTOS_UNICORE is not set
# CONFIG_ESP_INT_WDT is not set
# CONFIG_ESP_TASK_WDT_EN is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8

CONFIG_ESP_SDR_UART_BAUD=2000000

# Guition JC3248W535 (ESP32-S3R8: 8 MB octal PSRAM, 16 MB flash, 3.5" AXS15231B).
CONFIG_ESP_SDR_JC3248=y
CONFIG_ESP_SDR_SCAN_INTERVAL_S=9
CONFIG_ESP_SDR_PAGE_SECONDS=0
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# The display driver must not push IRAM/DRAM into the RF dump aperture.
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# Internal SRAM ends where the S3's RF ring begins: big UI arrays to PSRAM,
# FreeRTOS and heap code to flash (frees IRAM, which shifts DRAM).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# BLE device list (sniffer page BLE LISTE): NimBLE observer only.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
# CONFIG_BT_NIMBLE_SECURITY_ENABLE is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_EXT_SCAN=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=1
# CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV is not set
# CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC is not set

# The UI draws into PSRAM and the display driver reads it back across
# rows: 64-byte cache lines halve the misses (about +1.5 frames/s).
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
